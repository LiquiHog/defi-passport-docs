{
  "ignorePatterns": [
    {
      "pattern": "^https://discord.gg/"
    }
  ],
  "httpHeaders": [
    {
      "urls": [
        "https://github.com",
        "https://x.com"
      ],
      "headers": {
        "Accept": "text/html"
      }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [
    200,
    206,
    301,
    302,
    403,
    999
  ]
}
